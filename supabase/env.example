# Secrets for the lead-submit Edge Function.
# Set with:  supabase secrets set --env-file supabase/.env   (never commit the real file)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided automatically by Supabase.

# Comma-separated list of sites allowed to submit
ALLOWED_ORIGINS=https://www.candies.studio,https://candies.studio

# Team notification email (Resend — verify candies.studio in Resend first)
RESEND_API_KEY=
LEAD_FROM_EMAIL=Candies Studio Leads <leads@candies.studio>
LEAD_NOTIFY_TO=create@candies.studio

# Optional: also POST each lead to a CRM / Zapier / Make / Google Sheets webhook
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Meta Conversions API (Events Manager → your Pixel → Settings → Conversions API → Generate access token)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=v26.0
# Use only while testing in Events Manager → Test events, then remove
META_TEST_EVENT_CODE=

# Optional Cloudflare Turnstile (pair with NEXT_PUBLIC_TURNSTILE_SITE_KEY on the site)
TURNSTILE_SECRET_KEY=

# Any random string — salts the IP hash used for rate limiting
RATE_LIMIT_SALT=
